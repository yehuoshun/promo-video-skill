{
  "name": "self-promo",
  "private": true,
  "version": "0.1.0",
  "description": "promo-video-skill 自己的宣传片：施工图版式，横竖双版",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Main out/still.png --frame=45",
    "still:v": "remotion still src/index.ts Vertical out/still-v.png --frame=210",
    "stills": "..\\..\\scripts-win\\stills.cmd .",
    "check:stills": "python ../../scripts-win/check_stills.py out/stills",
    "sheet": "python ../../scripts-win/sheet.py --dir out/stills --out out/sheet.jpg --cols 3",
    "render": "remotion render src/index.ts Main out/demo-1080p.mp4 --codec=h264 --crf=18",
    "render:v": "remotion render src/index.ts Vertical out/demo-vertical.mp4 --codec=h264 --crf=18",
    "render4k": "remotion render src/index.ts Main4k out/demo-4k.mp4 --codec=h264 --crf=16",
    "render:effects": "remotion render src/index.ts Effects out/effects.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit",
    "lint:timing": "python ../../scripts-win/check_timing.py timing.json --allow-duration",
    "verify": "..\\..\\scripts-win\\verify.cmd ."
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/lottie": "4.0.543",
    "flubber": "0.4.2",
    "lottie-web": "^5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
